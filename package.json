{
    "name": "coreverse-launcher",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=22.18.0",
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
    "scripts": {
        "dev": "vite",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "typecheck:compat": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.node.json --noEmit",
        "rust:fmt": "cargo fmt --all",
        "rust:fmt:check": "cargo fmt --all --check",
        "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
        "rust:test": "cargo test --workspace",
        "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run rust:fmt:check && pnpm run rust:clippy && pnpm run rust:test"
    },
    "dependencies": {
        "@Coreverse-Game-Engine/db-client": "^0.5.5",
        "@radix-ui/react-dropdown-menu": "^2.1.0",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@supabase/supabase-js": "^2.50.0",
        "@tauri-apps/api": "^2.0.0",
        "@tauri-apps/plugin-deep-link": "^2.0.0",
        "@tauri-apps/plugin-http": "^2.0.0",
        "@tauri-apps/plugin-opener": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^25.0.0",
        "lucide-react": "^0.468.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^16.0.0",
        "react-router": "^7.0.0",
        "tailwind-merge": "^3.0.0",
        "tw-animate-css": "^1.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@tailwindcss/vite": "^4.0.0",
        "@tauri-apps/cli": "^2.0.0",
        "@types/node": "^22.18.13",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "tailwindcss": "^4.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.30.0",
        "vite": "^7.0.0"
    }
}
