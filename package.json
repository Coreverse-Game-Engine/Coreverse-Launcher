{
    "name": "coreverse-launcher",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=22.18.0",
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "scripts": {
        "dev": "vite",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "typecheck:compat": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.node.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "rust:fmt": "cargo fmt --all",
        "rust:fmt:check": "cargo fmt --all --check",
        "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
        "rust:test": "cargo test --workspace",
        "release:bump": "node scripts/release/bump-version.mjs",
        "release:check": "node scripts/release/check-version.mjs",
        "release:pubkey": "node scripts/release/set-updater-pubkey.mjs",
        "release:test": "node --test \"scripts/**/*.test.mjs\"",
        "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run rust:fmt:check && pnpm run rust:clippy && pnpm run rust:test && pnpm run release:check && pnpm run release:test"
    },
    "dependencies": {
        "@Coreverse-Game-Engine/db-client": "^0.6.0",
        "@radix-ui/react-dropdown-menu": "^2.1.0",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@supabase/supabase-js": "^2.50.0",
        "@tauri-apps/api": "^2.0.0",
        "@tauri-apps/plugin-deep-link": "^2.0.0",
        "@tauri-apps/plugin-http": "^2.0.0",
        "@tauri-apps/plugin-opener": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^25.0.0",
        "lucide-react": "^0.468.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^16.0.0",
        "react-router": "^7.0.0",
        "tailwind-merge": "^3.0.0",
        "tw-animate-css": "^1.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@tailwindcss/vite": "^4.0.0",
        "@tauri-apps/cli": "^2.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.18.13",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "tailwindcss": "^4.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.30.0",
        "vite": "^7.0.0",
        "vitest": "^5.0.1"
    }
}
